<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_brand"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="@string/incoming_call"
        android:textColor="@color/on_brand_muted"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/ic_videocam"
        app:drawableTint="@color/on_brand_muted" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Avatar grande con un aro que "late" mientras suena -->
    <FrameLayout
        android:id="@+id/aro"
        android:layout_width="184dp"
        android:layout_height="184dp"
        android:background="@drawable/bg_avatar_ring">

        <TextView
            android:id="@+id/tvAvatarLlamada"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_glass"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/on_brand"
            android:textSize="56sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivAvatarLlamada"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_avatar"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_profile_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvNombreLlamada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.AppLaboratorio.Headline"
        android:textColor="@color/on_brand"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/app_name"
        android:textColor="@color/on_brand_muted"
        android:textSize="15sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4" />

    <!-- Botones rechazar / contestar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRechazar"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/incoming_reject"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/call_reject"
                app:cornerRadius="38dp"
                app:icon="@drawable/ic_call_end"
                app:iconSize="34dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/incoming_reject"
                android:textColor="@color/on_brand"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContestar"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/incoming_accept"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/call_accept"
                app:cornerRadius="38dp"
                app:icon="@drawable/ic_videocam"
                app:iconSize="34dp"
                app:iconTint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/incoming_accept"
                android:textColor="@color/on_brand"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
