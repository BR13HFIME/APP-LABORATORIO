rules_version = '2';

// Reglas de seguridad de Firestore para AppLaboratorio.
// Publicarlas en: Firebase Console > Firestore Database > Reglas (pegar y "Publicar"),
// o con la CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada usuario: { email, rol }
    match /usuarios/{uid} {
      // Cualquier usuario con sesión puede ver la lista de contactos
      allow read: if request.auth != null;

      // Solo puedes crear tu propio perfil, y siempre como "usuario" (nadie se hace admin solo)
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == 'usuario';

      // Puedes editar tu perfil, pero no cambiar tu rol
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;

      allow delete: if false;
    }

    // Chats 1 a 1. El id del chat es "<uidMenor>_<uidMayor>"
    match /chats/{chatId}/mensajes/{mensajeId} {
      // Solo los dos participantes leen la conversación
      allow read: if request.auth != null
                  && request.auth.uid in chatId.split('_');

      // Solo un participante escribe, y únicamente a su nombre
      allow create: if request.auth != null
                    && request.auth.uid in chatId.split('_')
                    && request.resource.data.emisorId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
