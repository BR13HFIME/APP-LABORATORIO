rules_version = '2';

// Reglas de seguridad de Firestore para AppLaboratorio.
// Publicarlas en: Firebase Console > Firestore Database > Reglas (pegar y "Publicar"),
// o con la CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    // Perfil de cada usuario: { email, nombre, foto, rol }
    match /usuarios/{uid} {
      // Cualquier usuario con sesión puede ver la lista de contactos
      allow read: if conSesion();

      // Solo puedes crear tu propio perfil, y siempre como "usuario" (nadie se hace admin solo)
      allow create: if conSesion()
                    && request.auth.uid == uid
                    && request.resource.data.rol == 'usuario';

      // Puedes editar tu perfil (nombre, foto), pero no cambiar tu rol
      allow update: if conSesion()
                    && request.auth.uid == uid
                    && request.resource.data.get('rol', 'usuario') == resource.data.get('rol', 'usuario');

      allow delete: if false;
    }

    // Chats 1 a 1. El id del chat es "<uidMenor>_<uidMayor>"
    match /chats/{chatId} {
      function participa() {
        return conSesion() && request.auth.uid in chatId.split('_');
      }

      // Resumen para la lista de conversaciones: { participantes, ultimoMensaje, ... }
      // La lista se pide con where("participantes", "array-contains", miUid): para esa
      // consulta Firestore necesita la condición sobre "participantes" (no sobre el id).
      allow read: if participa()
                  || (conSesion() && request.auth.uid in resource.data.participantes);
      allow create, update: if participa();
      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if participa();

        // Solo un participante escribe, y únicamente a su nombre
        allow create: if participa()
                      && request.resource.data.emisorId == request.auth.uid;

        // Quien recibe el mensaje solo puede marcarlo como leído
        allow update: if participa()
                      && resource.data.emisorId != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);

        allow delete: if false;
      }
    }

    // Aviso de videollamada entrante. El id del documento es el uid de quien recibe.
    match /llamadas/{uid} {
      allow read: if conSesion()
                  && (request.auth.uid == uid || resource == null || resource.data.de == request.auth.uid);

      // Quien llama crea/actualiza el aviso a su nombre; quien recibe lo contesta
      allow create, update: if conSesion()
                            && (request.auth.uid == uid || request.resource.data.de == request.auth.uid);

      allow delete: if false;
    }
  }
}
